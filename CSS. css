<style>
  body { font-family: 'Segoe UI', sans-serif; padding: 20px; background: #eceff1; color: #333; }
  .card { max-width: 750px; margin: auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
  .header-tp { text-align: center; border-bottom: 3px solid #1a73e8; margin-bottom: 20px; padding-bottom: 10px; }
  h2 { color: #1a73e8; margin: 0; font-size: 1.4rem; }
  h3 { color: #546e7a; font-size: 1rem; margin-top: 5px; }
  
  .grid-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.95rem; }
  .grid-table th { background: #1a73e8; color: white; padding: 12px; }
  .grid-table td { border: 1px solid #cfd8dc; padding: 10px; text-align: center; }
  .consigna { text-align: left; font-weight: bold; background: #f9f9f9; width: 60%; }
  
  .pregunta-om-container { padding: 20px; background: #f8f9fa; border-radius: 10px; border: 1px solid #e0e0e0; }
  .select-estilizado { width: 100%; padding: 15px; font-size: 1.1rem; border-radius: 8px; border: 2px solid #1a73e8; cursor: pointer; background: white; margin-top: 10px; }

  input[type="radio"] { transform: scale(1.5); cursor: pointer; }
  .btn-principal { width: 100%; padding: 18px; background: #1a73e8; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: bold; margin-top: 25px; transition: 0.3s; }
  .btn-principal:disabled { background: #b0bec5; cursor: not-allowed; }
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; align-items: center; justify-content: center; z-index: 1000; }
  .modal-content { background: white; padding: 40px; border-radius: 20px; text-align: center; max-width: 450px; width: 90%; }

  /* --- Estilos VI (Video/Imágenes) --- */
  .grid-imagenes { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-top: 20px; }
  .opcion-imagen { border: 3px solid transparent; border-radius: 8px; cursor: pointer; transition: 0.3s; width: 100%; height: auto; object-fit: cover; aspect-ratio: 1; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
  .opcion-imagen:hover { transform: scale(1.05); }
  .opcion-imagen.seleccionada { border-color: #1a73e8; box-shadow: 0 0 15px rgba(26, 115, 232, 0.6); transform: scale(1.05); }
  .img-consigna { width: 100%; max-width: 600px; border-radius: 8px; border: 1px solid #ccc; margin-bottom: 20px; }

  /* --- Estilos RM (Tarjetas) --- */
  .grid-rm { 
    display: grid; 
    grid-template-columns: 1fr; 
    gap: 15px; 
    margin-top: 20px; 
  }
  .tarjeta-rm { 
    background: white; 
    border: 2px solid #cfd8dc; 
    border-radius: 10px; 
    padding: 15px; 
    text-align: center; 
    cursor: pointer; 
    transition: 0.2s; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    justify-content: center; 
    min-height: 80px; 
    font-size: 1.05rem;
    overflow-x: auto;
    box-sizing: border-box;
  }
  .tarjeta-rm:hover { border-color: #1a73e8; background: #f1f8ff; }
  .tarjeta-rm.seleccionada { border-color: #1a73e8; background: #e8f0fe; box-shadow: 0 0 10px rgba(26,115,232,0.3); font-weight: bold; }

  /* Control para evitar desbordes de formulas renderizadas */
  .tarjeta-rm .katex-display,
  .tarjeta-rm .MathJax_Display {
    margin: 4px 0 !important;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* --- ESTILOS DE EXAMEN (AJUSTE PARA U' Y V') --- */
  .examen-contenedor-opciones {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    gap: 14px !important;
    margin-top: 16px !important;
  }
  .examen-opcion-btn {
    display: block !important;
    width: 100% !important;
    clear: both !important;
    text-align: left !important;
    white-space: normal !important;
    word-break: break-word !important;
    box-sizing: border-box !important;
    font-size: 1.15rem !important;
    line-height: 1.6 !important;
    padding: 18px 22px !important;
    border-width: 2px !important;
    overflow-x: auto !important;
  }
  .examen-opcion-btn .mjx-chtml, 
  #contenedor-examen-main .mjx-chtml {
    font-size: 125% !important;
  }

  /* Clases de formato para derivaciones en dos filas */
  .flex { display: flex !important; }
  .flex-col { flex-direction: column !important; }
  .gap-2 { gap: 0.5rem !important; }
  .w-full { width: 100% !important; }
  .py-1 { padding-top: 0.25rem !important; padding-bottom: 0.25rem !important; }
  .pt-2 { padding-top: 0.5rem !important; }
  .border-t { border-top-width: 1px !important; border-top-style: solid !important; }
  .border-slate-200 { border-color: #e2e8f0 !important; }
  .text-slate-700 { color: #334155 !important; }
  .text-slate-400 { color: #94a3b8 !important; }
  .text-xs { font-size: 0.75rem !important; }
  .mr-2 { margin-right: 0.5rem !important; }
  .uppercase { text-transform: uppercase !important; }

  /* --- CA (Carga de Archivos) --- */
  .drop-zone { border: 2px dashed #1a73e8; border-radius: 10px; padding: 30px; text-align: center; color: #1a73e8; cursor: pointer; transition: 0.3s; background: #f1f8ff; }
  .drop-zone:hover { background: #e8f0fe; }
  .drop-zone p { margin: 0; font-weight: bold; }
  .file-info { margin-top: 10px; font-size: 0.9rem; color: #2e7d32; display: none; }

  /* --- CV (Checklist / Múltiple Selección) --- */
  .opcion-check { display: flex; align-items: center; padding: 15px; background: #fff; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 10px; cursor: pointer; transition: 0.2s; }
  .opcion-check:hover { background: #f9f9f9; }
  .opcion-check input { margin-right: 15px; transform: scale(1.3); }
  .opcion-check.activa { border-color: #1a73e8; background: #e8f0fe; }

  /* --- VF (Botones de Selección Rápida en Tabla) --- */
  .btn-vf { padding: 8px 15px; border: 1px solid #ccc; background: white; cursor: pointer; border-radius: 5px; font-weight: bold; transition: 0.2s; }
  .btn-v.seleccionado { background: #4caf50; color: white; border-color: #388e3c; }
  .btn-f.seleccionado { background: #f44336; color: white; border-color: #d32f2f; }

  @media (max-width: 500px) { .grid-rm { grid-template-columns: 1fr; } }

  /* Estilos para los botones de símbolos matemáticos del chat */
  #math-buttons {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin: 10px 0;
    flex-wrap: wrap;
  }

  .btn-math {
    background-color: #f0f4f8;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 16px;
    font-weight: bold;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 45px;
  }

  .btn-math:hover {
    background-color: #e2e8f0;
    border-color: #94a3b8;
  }

  .btn-math:active {
    transform: scale(0.95);
  }

  /* --- ESTILOS DE VIDAS EN BALANZA --- */
  .balanza-vidas-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 10px 0;
  }

  .balanza-corazon {
    font-size: 1.5rem;
    transition: all 0.3s ease;
    display: inline-block;
  }

  /* Estado Activo */
  .balanza-corazon.activo {
    color: #ff4d4d;
    transform: scale(1);
    filter: drop-shadow(0 2px 4px rgba(255, 77, 77, 0.3));
  }

  /* Estado Vacío / Perdido */
  .balanza-corazon.vacio {
    color: #cbd5e1;
    transform: scale(0.9);
    opacity: 0.5;
  }

  /* Animación cuando se pierde una vida */
  @keyframes perderVidaBalanza {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.4) rotate(-12deg);
      color: #ef4444;
    }
    60% {
      transform: scale(0.8) rotate(12deg);
    }
    100% {
      transform: scale(0.9);
      color: #cbd5e1;
      opacity: 0.5;
    }
  }

  .balanza-corazon.perdiendo {
    animation: perderVidaBalanza 0.5s ease-in-out forwards;
  }
</style>
